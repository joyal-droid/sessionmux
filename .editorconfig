# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,css,html,json,yml,yaml,toml,ps1,nsi}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.{nsi,bat,cmd}]
end_of_line = crlf

[LICENSE]
indent_style = unset
indent_size = unset
